# ============================================================
# QuicTools environment variables
# ============================================================

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/quictools?schema=public"

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://quictools.cc"
NEXT_PUBLIC_SITE_NAME="QuicTools"

# --- Search Console / verification ---
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_BING_VERIFICATION=""

# --- Google AdSense ---
NEXT_PUBLIC_ADSENSE_ID="ca-pub-3655016924906610"
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=""
NEXT_PUBLIC_ADSENSE_SLOT_TOP=""
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=""
NEXT_PUBLIC_ADSENSE_SLOT_MIDDLE=""
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=""
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=""

# --- Monetization ---
# Keep false for the current free + ads model.
NEXT_PUBLIC_ENABLE_PRO_PAYWALL="false"

# --- Future Pro/payment backend (kept disabled from normal user flow) ---
JWT_SECRET=""
COOKIE_DOMAIN=""
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_CHECKOUT_LK=""
LEMONSQUEEZY_CHECKOUT_GLOBAL=""

# --- Exchange Rates ---
EXCHANGE_RATE_API_KEY=""

# --- Media / video downloader ---
YTDLP_PATH="/usr/local/bin/yt-dlp"
HTTPS_PROXY=""
HTTP_PROXY=""
SOCKS_PROXY=""
MEDIA_IG_SESSION="true"
MEDIA_TIKTOK_SESSION="true"

# Usage limits are disabled while the free/ad-first model is active.
DISABLE_USAGE_LIMIT="true"
