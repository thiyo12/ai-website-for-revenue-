# ============================================================
# QuicTools environment variables
# Copy this file to .env and fill in your own values.
# ============================================================

# --- Database (Prisma + SQLite) ---
# Local SQLite database file path
DATABASE_URL="file:./dev.db"

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://quictools.cc"
SITE_NAME="QuicTools"

# --- Search Console / verification (optional) ---
NEXT_PUBLIC_GSC_VERIFICATION=""
NEXT_PUBLIC_BING_VERIFICATION=""

# --- Google AdSense (optional) ---
# Uncomment these and fill in your IDs to enable ads.
# Each slot maps to a reserved position across the site:
#   header  = below the site header (every page)
#   top     = top of each tool/game page
#   inline  = right after the tool/game card and between homepage sections
#   middle  = before the related-links section on tool/game pages
#   bottom  = end of each page
#   footer  = reserved (not currently rendered)
NEXT_PUBLIC_ADSENSE_ID=""
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=""
NEXT_PUBLIC_ADSENSE_SLOT_TOP=""
NEXT_PUBLIC_ADSENSE_SLOT_INLINE=""
NEXT_PUBLIC_ADSENSE_SLOT_MIDDLE=""
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=""
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=""

# --- Paywall unlock (JWT) ---
# A long, random secret string used to sign the unlock cookie.
JWT_SECRET=""
# Optional cookie domain (leave empty for current domain only).
COOKIE_DOMAIN=""

# --- Lemon Squeezy ---
# API key for the Lemon Squeezy API.
LEMONSQUEEZY_API_KEY=""
# One-time checkout URLs (LK and Global variants for geo-pricing).
LEMONSQUEEZY_CHECKOUT_LK=""
LEMONSQUEEZY_CHECKOUT_GLOBAL=""

# --- Exchange Rates (optional) ---
# API key for exchangerate-api.com (free tier works without key).
EXCHANGE_RATE_API_KEY=""

# ============================================================
# Media / video downloader (VPS deployment)
# ============================================================

# --- yt-dlp extraction engine ---
# Absolute path to the yt-dlp binary on the server.
# Most Linux systems use /usr/local/bin/yt-dlp (pipx/pip install).
YTDLP_PATH="/usr/local/bin/yt-dlp"

# --- Optional: trusted / residential proxy for Instagram + TikTok ---
# Setting one of these allows the downloader to reach platforms that
# block direct datacenter-IP requests (e.g. a residential proxy or a
# clean VPS IP). Leave empty if this server's IP is already trusted.
HTTPS_PROXY=""
HTTP_PROXY=""
SOCKS_PROXY=""
# Legacy alias also read by the code:
# SOCKS=""

# --- Warm-session harvesting (uses the installed Playwright browser) ---
# Defaults to true; set "false" to disable harvesting cookies on boot.
MEDIA_IG_SESSION="true"
MEDIA_TIKTOK_SESSION="true"

# --- TLS trust anchor for yt-dlp ---
# Optional: if yt-dlp reports SSL errors, point this at a CA bundle.
# SSL_CERT_FILE=""

# --- Enable/disable usage limits (default already true) ---
DISABLE_USAGE_LIMIT="true"
